{
  "name": "@red-cup-engineering/path-walking-service",
  "version": "0.5.2",
  "private": false,
  "type": "module",
  "description": "Walks the real filesystem under one explicit root and reports the files, symlinks, and directories it finds, digested and deterministically sorted. Use to read a working-tree chart off disk before slicing or graphing it.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/computer-file-engineering-services-section.git",
    "directory": "services/file-observation-services-section/services/path-walking-service"
  },
  "exports": "./src/walk-posix-paths.mjs",
  "bin": {
    "walk-posix-paths": "./scripts/walk-posix-paths.mjs"
  },
  "scripts": {
    "check": "node --check src/walk-posix-paths.mjs && node --check scripts/walk-posix-paths.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "package.json",
    "README*",
    "LICENSE*",
    "scripts",
    "src"
  ]
}
